# Copy to .env and fill in. Never commit .env.
#
# Single-operator mode. Every request is treated as the seeded operator below,
# which is why BIND_HOST must stay on loopback — the server refuses to start
# otherwise. See src/config/bind-guard.ts.
AUTH_MODE=none
BIND_HOST=127.0.0.1
PORT=3000

# Who the single operator is. Required while AUTH_MODE=none, because every write
# records an actor.
OPERATOR_NAME=
OPERATOR_EMAIL=

# Required from DC-02 onwards.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/dpwh_doc_control

# Optional. Where `npm test` runs.
#
# The suite truncates tables, so it never uses DATABASE_URL. By default it
# derives a sibling database by appending _test to the name above and creates it
# on the first run, leaving your working data alone. Set this only to put the
# test database somewhere else — the name must still end in _test, or the run
# aborts rather than risk truncating the wrong thing.
# TEST_DATABASE_URL=

# Optional. Where the ClamAV signature database lives, if not clamscan's default.
# A fresh install has no signatures, and the default directory usually needs
# administrator rights to write to. The scan gate treats a scanner with no
# signatures as unavailable, never as a pass.
# CLAMAV_DB_PATH=
