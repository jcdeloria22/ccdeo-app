# Copy to .env and fill in. Never commit .env.
#
# Single-operator mode. Every request is treated as the seeded operator below,
# which is why BIND_HOST must stay on loopback — the server refuses to start
# otherwise. See src/config/bind-guard.ts.
AUTH_MODE=none
BIND_HOST=127.0.0.1
PORT=3000

# Who the single operator is. Required while AUTH_MODE=none, because every write
# records an actor.
OPERATOR_NAME=
OPERATOR_EMAIL=

# Required from DC-02 onwards.
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/dpwh_doc_control

# Optional. Where `npm test` runs.
#
# The suite truncates tables, so it never uses DATABASE_URL. By default it
# derives a sibling database by appending _test to the name above and creates it
# on the first run, leaving your working data alone. Set this only to put the
# test database somewhere else — the name must still end in _test, or the run
# aborts rather than risk truncating the wrong thing.
# TEST_DATABASE_URL=

# Hosted deployment only.
#
# AUTH_MODE=password is what lets the server bind anything but 127.0.0.1 — see
# src/config/bind-guard.ts. Set all four together or none of them.
# AUTH_MODE=password
# BIND_HOST=0.0.0.0
# NODE_ENV=production
# TRUST_PROXY=true          # behind a router that sets X-Forwarded-For
#
# TLS to the database: off | require | no-verify. Railway's private network
# needs none; its public proxy needs one of the other two.
# DATABASE_SSL=require
#
# The session cookie is Secure by default in production and cannot be turned off
# there. Set this to false ONLY for a local http build in password mode.
# SESSION_COOKIE_SECURE=false

# Object storage. All four together, or none — a half-configured bucket is
# refused rather than falling back to the local filesystem, because on a
# container platform that silently loses every upload at the next deploy.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=            # only for an S3-compatible store that is not R2

# Optional. Where the ClamAV signature database lives, if not clamscan's default.
# A fresh install has no signatures, and the default directory usually needs
# administrator rights to write to. The scan gate treats a scanner with no
# signatures as unavailable, never as a pass.
# CLAMAV_DB_PATH=
